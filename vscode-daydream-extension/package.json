{
  "name": "vscode-daydream-extension",
  "displayName": "Daydream",
  "description": "Syntax highlighting for Daydream (.daydream) files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "daydream",
        "aliases": [
          "Daydream",
          "daydream"
        ],
        "extensions": [
          ".daydream"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "daydream",
        "scopeName": "source.daydream",
        "path": "./syntaxes/daydream.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "daydream",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}
