{
    "Function Definition": {
        "prefix": "fn",
        "body": [
            "fn ${1:name}(${2:args}) {",
            "\t$0",
            "}"
        ],
        "description": "Define a new function"
    },
    "Test Case": {
        "prefix": "test",
        "body": [
            "test(\"${1:name}\", fn() {",
            "\t$0",
            "})"
        ],
        "description": "Create a new test case"
    },
    "Test Group": {
        "prefix": "test_group",
        "body": [
            "test_group(\"${1:group_name}\", [",
            "\t$0",
            "])"
        ],
        "description": "Create a new test group"
    },
    "Test Expect": {
        "prefix": "expect",
        "body": [
            "test_expect(${1:actual}, ${2:expected})"
        ],
        "description": "Assertion for tests"
    },
    "Import": {
        "prefix": "import",
        "body": [
            "import ${1:items} from \"${2:path}\""
        ],
        "description": "Import module"
    },
    "Print": {
        "prefix": "print",
        "body": [
            "print($1)"
        ],
        "description": "Print to console"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "If statement"
    },
    "If Else Statement": {
        "prefix": "ifelse",
        "body": [
            "if (${1:condition}) {",
            "\t$2",
            "} else {",
            "\t$0",
            "}"
        ],
        "description": "If-Else statement"
    },
    "For Loop": {
        "prefix": "for",
        "body": [
            "for (${1:var i = 0}; ${2:i < count}; ${3:i++}) {",
            "\t$0",
            "}"
        ],
        "description": "For loop"
    },
    "While Loop": {
        "prefix": "while",
        "body": [
            "while (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "While loop"
    },
    "Try Catch": {
        "prefix": "try",
        "body": [
            "try {",
            "\t$1",
            "} catch (${2:e}) {",
            "\t$0",
            "}"
        ],
        "description": "Try-Catch block"
    },
    "Log": {
        "prefix": "log",
        "body": [
            "print($1)"
        ],
        "description": "Print to console"
    },
