{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Daydream",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#regex" },
    { "include": "#function-definitions" },
    { "include": "#storage" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#support-functions" },
    { "include": "#function-calls" },
    { "include": "#properties" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.daydream",
          "match": "//.*$"
        },
        {
          "name": "comment.block.daydream",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.daydream",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.daydream",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.daydream",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.daydream",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.daydream",
          "match": "/(?![*+?])(\\\\.|[^/\\n])*/[gimuy]*"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.daydream" },
            "2": { "name": "entity.name.function.daydream" }
          }
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.daydream",
          "match": "\\b(var|global)\\b"
        },
        {
          "name": "storage.modifier.daydream",
          "match": "\\b(static|public|private|protected|abstract|implements|extends)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.daydream",
          "match": "\\b(if|else|for|while|repeat|return|break|continue|in|try|catch|throw|switch|case|default)\\b"
        },
        {
          "name": "keyword.control.import.daydream",
          "match": "\\b(import|export|from|as|package)\\b"
        },
        {
          "name": "storage.type.function.daydream", 
          "match": "\\b(fn)\\b"
        },
        {
          "name": "keyword.other.daydream",
          "match": "\\b(class|new|super|this|interface)\\b"
        },
        {
          "name": "keyword.operator.word.daydream",
          "match": "\\b(and|or|not|typeof|instanceof)\\b"
        }
      ]
    },
    "support-functions": {
      "patterns": [
        {
          "name": "support.function.daydream",
          "match": "\\b(test_group|test|test_expect|print|array_length|array_push|array_pop|array_contains|array_insert|array_delete|array_sort|struct_get_names|struct_stringify|struct_parse|string_length|string_copy|string_char_at|string_replace_all|string_pos|string_upper|string_lower|is_string|is_real|is_array|is_struct|is_undefined|substring|floor|ceil|round|abs|sign|min|max|random|random_range|irandom|irandom_range|input_check|input_check_pressed|input_check_released)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.daydream",
          "match": "\\b(true|false|undefined|null|infinity|NaN)\\b"
        },
        {
          "name": "storage.type.function.daydream",
          "match": "\\b(PI|TAU|E|PHI|CURRENT_YEAR|CURRENT_MONTH|CURRENT_DAY|CURRENT_WEEKDAY|CURRENT_HOUR|CURRENT_MINUTE|CURRENT_SECOND|FPS|FPS_REAL|DELTA_TIME|SYS_USERNAME|SYS_HOSTNAME|SYS_PID|SYS_CPU|SYS_CPU_BRAND|SYS_CPU_VENDOR|SYS_CPU_FREQ|SYS_CORE_COUNT|SYS_CPU_USAGE|SYS_CPU_PROC|SYS_GPU|SYS_GPU_VRAM|SYS_GPU_USAGE|SYS_RAM_MAX|SYS_RAM_USED|SYS_RAM_PROC|OS_TYPE|OS_VERSION|WINDOW_WIDTH|WINDOW_HEIGHT|DISPLAY_WIDTH|DISPLAY_HEIGHT|WORLD_MOUSE_X|WORLD_MOUSE_Y|DEVICE_MOUSE_X|DEVICE_MOUSE_Y|GUI_MOUSE_X|GUI_MOUSE_Y|ERROR_TYPE)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.daydream"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.daydream" },
            "2": { "name": "variable.other.property.daydream" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\:)",
          "name": "variable.other.property.daydream"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.daydream",
          "match": "(\\+|\\-|\\*|\\/|%|\\^|\\=|\\!|\\<|\\>|\\&|\\||\\~|\\?|\\:)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.daydream",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.daydream",
          "match": "\\b\\d+(_\\d+)*(\\.\\d+(_\\d+)*)?\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.daydream",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.daydream"
}
