/* create world ui */
/* two-column layout: left panel = form, right panel = expanded details */

var _padding = 8
var _spacing = 6
var _field_width = 180
var _field_height = 18
var _button_height = 20
var _slider_height = 14
var _section_spacing = 4
var _label_scale = 0.6
var _label_colour = #8888aa
var _section_colour = #6666aa
var _toggle_width = 20
var _right_width = 200

@area(create_world) {
    size = (640, 440)
    position = (160, 50)
    layout = LAYOUT_VERTICAL
    spacing = 16
    padding = _padding

    /* Header: Back button and Centered Title */
    @area(header) {
        size = (624, 30)
        layout = LAYOUT_NONE

        @button(back_btn) {
            text = "< back"
            size = (60, 20)
            position = (0, 5)
        }

        @text(title_label) {
            text = "Create World"
            colour = #ffffff
            text_scale = 1.0
            size = (200, 20)
            anchor_x = "center"
            anchor_y = "middle"
        }
    }


    /* Content Split: Left panel | Divider | Right panel */
    @area(content_split) {
        size = (624, 340)
        layout = LAYOUT_HORIZONTAL
        spacing = 0

        /* left column: identity (50% approx) */
        @area(left_panel) {
            size = (311, 340)
            layout = LAYOUT_VERTICAL
            spacing = 12
            padding = (60, 0, 0, 0) /* Extra top padding to center the inputs vertically */

            @text(name_label) {
                text = "name"
                colour = _label_colour
                text_scale = _label_scale
                size = (_field_width, 10)
            }

            @area(name_row) {
                layout = LAYOUT_HORIZONTAL
                spacing = 4
                size = (_field_width, _field_height)

                @textbox(name_input) {
                    size = (155, _field_height)
                    placeholder = "enter world name..."
                    max_length = 40
                    text = ""
                }

                @button(name_random_btn) {
                    text = "?"
                    size = (_toggle_width, _field_height)
                }
            }

            @text(seed_label) {
                text = "seed"
                colour = _label_colour
                text_scale = _label_scale
                size = (_field_width, 10)
            }

            @area(seed_row) {
                layout = LAYOUT_HORIZONTAL
                spacing = 4
                size = (_field_width, _field_height)

                @textbox(seed_input) {
                    size = (155, _field_height)
                    placeholder = "enter seed..."
                    text = ""
                }

                @button(seed_random_btn) {
                    text = "?"
                    size = (_toggle_width, _field_height)
                }
            }
        }

        /* Vertical Divider (Centered) */
        @line(divider) {
            thickness = 1
            colour = #444455
            start_x = 0
            start_y = 0
            end_x = 0
            end_y = 330
            size = (2, 330)
        }

        /* right column: options and rules (50% approx) */
        @scroll_area(right_panel) {
            size = (311, 340)
            layout = LAYOUT_VERTICAL
            spacing = _spacing
            padding = 4


            /* difficulty */
            @text(difficulty_label) {
                text = "difficulty"
                colour = _label_colour
                text_scale = _label_scale
                size = (_right_width, 10)
            }

            @slider(difficulty_slider) {
                size = (_right_width, _slider_height)
                min_value = 0
                max_value = 4
                value = 1
                step = 1
            }


            /* death penalty */
            @button(death_penalty_toggle) {
                text = "> death penalty"
                size = (_right_width, _button_height)
            }

            @area(death_penalty_content) {
                layout = LAYOUT_VERTICAL
                spacing = _section_spacing
                visible = false

                @text(item_drop_label) {
                    text = "item drop percentage"
                    colour = _label_colour
                    text_scale = _label_scale
                    size = (_right_width, 10)
                }

                @slider(item_drop_slider) {
                    size = (_right_width, _slider_height)
                    min_value = 0
                    max_value = 100
                    value = 100
                    step = 5
                }

                @text(item_durability_label) {
                    text = "item durability percentage"
                    colour = _label_colour
                    text_scale = _label_scale
                    size = (_right_width, 10)
                }

                @slider(item_durability_slider) {
                    size = (_right_width, _slider_height)
                    min_value = 0
                    max_value = 100
                    value = 100
                    step = 5
                }
            }


            /* advanced options */
            @button(advanced_toggle) {
                text = "> advanced options"
                size = (_right_width, _button_height)
            }

            @area(advanced_content) {
                layout = LAYOUT_VERTICAL
                spacing = 10
                padding = (0, 0, 0, 10) /* Indent contents slightly */
                visible = false
                
                /* backup (Nested) */
                @button(backup_toggle) {
                    text = "> backup"
                    size = (_right_width, _button_height)
                }

                @area(backup_content) {
                    layout = LAYOUT_VERTICAL
                    spacing = _section_spacing
                    visible = false

                    @text(backup_interval_label) {
                        text = "backup interval"
                        colour = _label_colour
                        text_scale = _label_scale
                        size = (_right_width, 10)
                    }

                    @slider(backup_interval_slider) {
                        size = (_right_width, _slider_height)
                        min_value = 1
                        max_value = 60
                        value = 5
                        step = 1
                    }

                    @text(backup_slots_label) {
                        text = "max backups"
                        colour = _label_colour
                        text_scale = _label_scale
                        size = (_right_width, 10)
                    }

                    @slider(backup_slots_slider) {
                        size = (_right_width, _slider_height)
                        min_value = 1
                        max_value = 10
                        value = 3
                        step = 1
                    }
                }


                /* permissions (Nested) */
                @text(permissions_header) {
                    text = "permissions"
                    colour = _label_colour
                    text_scale = 0.7
                    size = (_right_width, 14)
                }

                @area(permissions_row) {
                    layout = LAYOUT_HORIZONTAL
                    spacing = 10
                    size = (300, 20)

                    @radio_button(perm_none) {
                        text = "none"
                        value = "none"
                        group = "permissions"
                        selected = true
                    }

                    @radio_button(perm_min) {
                        text = "min"
                        value = "min"
                        group = "permissions"
                    }

                    @radio_button(perm_max) {
                        text = "max"
                        value = "max"
                        group = "permissions"
                    }
                }


                /* game rules (Nested) */
                @button(game_rules_toggle) {
                    text = "> game rules"
                    size = (_right_width, _button_height)
                }

                @area(game_rules_content) {
                    layout = LAYOUT_VERTICAL
                    spacing = _section_spacing
                    visible = false

                    @text(advance_time_label) {
                        text = "advance time"
                        colour = _label_colour
                        text_scale = _label_scale
                        size = (_right_width, 10)
                    }

                    @slider(advance_time_slider) {
                        size = (_right_width, _slider_height)
                        min_value = 0
                        max_value = 32
                        value = 1
                        step = 1
                    }

                    @area(friendly_fire_row) {
                        layout = LAYOUT_HORIZONTAL
                        spacing = 6
                        size = (_right_width, _field_height)

                        @text(friendly_fire_label) {
                            text = "friendly fire"
                            colour = _label_colour
                            text_scale = _label_scale
                            size = (100, _field_height)
                        }

                        @button(friendly_fire_btn) {
                            text = "[ ]"
                            size = (_toggle_width, _field_height)
                        }
                    }

                    @button(item_drops_toggle) {
                        text = "> item drops"
                        size = (_right_width, 16)
                    }

                    @area(item_drops_content) {
                        layout = LAYOUT_VERTICAL
                        spacing = _section_spacing
                        padding = 4
                        visible = false

                        @area(entity_drops_row) {
                            layout = LAYOUT_HORIZONTAL
                            spacing = 6
                            size = (_right_width, _field_height)

                            @text(entity_drops_label) {
                                text = "entity drops"
                                colour = _label_colour
                                text_scale = _label_scale
                                size = (100, _field_height)
                            }

                            @button(entity_drops_btn) {
                                text = "[x]"
                                size = (_toggle_width, _field_height)
                            }
                        }

                        @area(tile_drops_row) {
                            layout = LAYOUT_HORIZONTAL
                            spacing = 6
                            size = (_right_width, _field_height)

                            @text(tile_drops_label) {
                                text = "tile drops"
                                colour = _label_colour
                                text_scale = _label_scale
                                size = (100, _field_height)
                            }

                            @button(tile_drops_btn) {
                                text = "[x]"
                                size = (_toggle_width, _field_height)
                            }
                        }
                    }

                    @text(natural_regen_label) {
                        text = "natural regeneration"
                        colour = _label_colour
                        text_scale = _label_scale
                        size = (_right_width, 10)
                    }

                    @slider(natural_regen_slider) {
                        size = (_right_width, _slider_height)
                        min_value = 0
                        max_value = 4
                        value = 1
                        step = 1
                    }
                }
            }
        }
    }

    /* Footer: Centered Create Button */
    @area(footer) {
        size = (624, 30)
        layout = LAYOUT_NONE
        
        @button(create_btn) {
            text = "create world"
            size = (140, 24)
            anchor_x = "center"
            anchor_y = "middle"
        }
    }
}
