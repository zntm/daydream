@area(settings_menu) {
    size = (960, 540)
    position = ORIGIN_TOP_LEFT

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Settings"
        text_scale = 2
    }

    @area(main_content) {
        position = ORIGIN_CENTER
        size = (800, 380)

        @area(left_column) {
            position = ORIGIN_TOP_LEFT
            size = (240, 380)
            layout = LAYOUT_VERTICAL
            spacing = 8
            
            @button(btn_cat_general) {
                size = (240, 48)
                text = "General"
            }
            
            @button(btn_cat_graphics) {
                size = (240, 48)
                text = "Graphics"
            }
            
            @button(btn_cat_audio) {
                size = (240, 48)
                text = "Audio"
            }
            
            @button(btn_cat_controls) {
                size = (240, 48)
                text = "Controls"
            }
            
            @button(btn_cat_game) {
                size = (240, 48)
                text = "Game"
            }
        }

        @area(right_column) {
            position = ORIGIN_TOP_RIGHT
            size = (540, 380)
            background = #000000

            @scroll_area(settings_scroll) {
                position = ORIGIN_TOP_LEFT
                size = (540, 380)

                // The settings list injected via GML
                @area(settings_list) {
                    position = ORIGIN_TOP_LEFT
                    size = (540, 380)
                    layout = LAYOUT_VERTICAL
                    spacing = 8
                }
            }
        }
    }

    @area(bottom_buttons) {
        position = ORIGIN_BOTTOM_CENTER + (0, -32)
        size = (800, 48)

        @button(btn_back) {
            position = ORIGIN_MIDDLE_LEFT
            size = (128, 48)
            text = "Back"
        }
    }
}
