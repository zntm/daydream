// settings screen layout

@area(settings_menu) {
    size = (960, 540)
    position = ORIGIN_CENTER

    @button(btn_back) {
        position = ORIGIN_TOP_LEFT + (24, 24)
        size = (64, 32)
        text = "Back"
    }

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Settings"
        text_scale = 1.5
    }

    @area(main_content) {
        position = ORIGIN_CENTER + (0, 16)
        size = (880, 420)

        @area(left_column) {
            position = ORIGIN_TOP_LEFT
            size = (200, 420)
            layout = LAYOUT_VERTICAL
            spacing = 4
            
            @button(btn_cat_general) {
                size = (200, 36)
                text = "General"
            }
            
            @button(btn_cat_graphics) {
                size = (200, 36)
                text = "Graphics"
            }
            
            @button(btn_cat_controls) {
                size = (200, 36)
                text = "Controls"
            }
            
            @button(btn_cat_audio) {
                size = (200, 36)
                text = "Audio"
            }
            
            @button(btn_cat_accessibility) {
                size = (200, 36)
                text = "Accessibility"
            }
        }

        @area(right_column) {
            position = ORIGIN_TOP_RIGHT
            size = (660, 420)

            @scroll_area(settings_scroll) {
                position = ORIGIN_TOP_LEFT
                size = (660, 420)

                @area(settings_list) {
                    position = ORIGIN_TOP_LEFT
                    size = (660, 420)
                    layout = LAYOUT_VERTICAL
                    spacing = 8
                }
            }
        }
    }
}
