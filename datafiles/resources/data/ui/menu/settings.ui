@area(settings_menu) {
    size = (640, 480)
    position = ORIGIN_CENTER
	background = #0e0e1a

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Settings"
        text_scale = 2
    }

    @area(main_content) {
        position = ORIGIN_CENTER + (0, -16)
        size = (600, 320)

        @area(left_column) {
            position = ORIGIN_TOP_LEFT
            size = (180, 320)
            layout = LAYOUT_VERTICAL
            spacing = 8
            
            @button(btn_cat_general) {
                size = (180, 40)
                text = "General"
            }
            
            @button(btn_cat_graphics) {
                size = (180, 40)
                text = "Graphics"
            }
            
            @button(btn_cat_audio) {
                size = (180, 40)
                text = "Audio"
            }
            
            @button(btn_cat_controls) {
                size = (180, 40)
                text = "Controls"
            }
            
            @button(btn_cat_game) {
                size = (180, 40)
                text = "Game"
            }
        }

        @area(right_column) {
            position = ORIGIN_TOP_RIGHT
            size = (400, 320)
            background = #000000

            @scroll_area(settings_scroll) {
                position = ORIGIN_TOP_LEFT
                size = (400, 320)

                // The settings list injected via GML
                @area(settings_list) {
                    position = ORIGIN_TOP_LEFT
                    size = (400, 320)
                    layout = LAYOUT_VERTICAL
                    spacing = 8
                }
            }
        }
    }

    @area(bottom_buttons) {
        position = ORIGIN_BOTTOM_CENTER + (0, -16)
        size = (600, 48)

        @button(btn_back) {
            position = ORIGIN_MIDDLE_LEFT
            size = (96, 32)
            text = "Back"
        }
    }
}
