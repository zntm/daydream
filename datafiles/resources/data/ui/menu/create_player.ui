@area(create_player_menu) {
    size = (640, 480)
    position = ORIGIN_CENTER
	background = #0e0e1a

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Create Player"
        text_scale = 2
    }

    @area(main_content) {
        position = ORIGIN_CENTER + (0, -16)
        size = (600, 320)

        @area(left_column) {
            position = ORIGIN_TOP_LEFT
            size = (280, 320)
            
            @button(preview_renderer) {
                position = ORIGIN_TOP_CENTER + (0, 16)
                size = (128, 128)
            }

            @textbox(input_name) {
                position = ORIGIN_TOP_CENTER + (0, 160)
                size = (200, 24)
                placeholder = "enter name..."
            }

            @button(btn_voice) {
                position = ORIGIN_TOP_CENTER + (0, 200)
                size = (200, 24)
                text = "Voice"
            }

            @area(pitch_container) {
                position = ORIGIN_TOP_CENTER + (0, 240)
                size = (200, 24)

                @text(label_pitch) {
                    position = ORIGIN_MIDDLE_LEFT
                    text = "Pitch"
                    text_scale = 1
                }

                @slider(slider_pitch) {
                    position = ORIGIN_MIDDLE_RIGHT
                    size = (120, 16)
                    min_value = 0.5
                    max_value = 1.5
                    value = 1.0
                    step = 0.1
                }
            }
        }

		@line(divider) {
			position = ORIGIN_CENTER
			start = (0, -140)
			end = (0, 140)
			thickness = 1
			colour = #3a3a4a
		}

        @area(right_column) {
            position = ORIGIN_TOP_RIGHT
            size = (280, 320)

            @text(label_design) {
                position = ORIGIN_TOP_CENTER + (0, 16)
                text = "Design"
            }

            @scroll_area(design_scroll) {
                position = ORIGIN_TOP_CENTER + (0, 48)
                size = (280, 272)

                // Handled in GML
                @area(design_list) {
                    position = ORIGIN_TOP_LEFT
                    size = (280, 272)
                }
            }
        }
    }

    @area(bottom_buttons) {
        position = ORIGIN_BOTTOM_CENTER + (0, -16)
        size = (600, 48)

        @button(btn_back) {
            position = ORIGIN_MIDDLE_LEFT
            size = (96, 32)
            text = "Back"
        }

        @button(btn_create_player) {
            position = ORIGIN_CENTER
            size = (180, 32)
            text = "Create Player"
        }
    }
}
