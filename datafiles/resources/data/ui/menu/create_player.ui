// create player screen layout

var FRAME_W = 920
var FRAME_H = 500
var PAD = 12
var HEADER_H = 44
var FOOTER_H = 52
var GAP = 12
var CONTENT_H = FRAME_H - (PAD * 2) - HEADER_H - GAP - FOOTER_H
var LEFT_W = 360
var RIGHT_W = FRAME_W - (PAD * 2) - LEFT_W - GAP
var FIELD_W = LEFT_W - 24

@area(create_player_menu) {
    size = (960, 540)
    position = ORIGIN_MIDDLE_CENTER

    @area(screen_frame) {
        position = ORIGIN_MIDDLE_CENTER
        size = (FRAME_W, FRAME_H)
        border_color = #3a3a4a

        @area(header_bar) {
            position = ORIGIN_TOP_LEFT + (PAD, PAD)
            size = (FRAME_W - (PAD * 2), HEADER_H)
            border_color = #3a3a4a

            @button(btn_back) {
                position = ORIGIN_TOP_LEFT + (8, 6)
                size = (64, 32)
                text = "Back"
            }

            @text(title) {
                position = ORIGIN_TOP_LEFT + (84, 22)
                text = "Create Player"
                text_scale = 1.2
                halign = fa_left
                valign = fa_middle
            }
        }

        @area(left_panel) {
            position = ORIGIN_TOP_LEFT + (PAD, PAD + HEADER_H + GAP)
            size = (LEFT_W, CONTENT_H)
            border_color = #3a3a4a

            @area(preview_frame) {
                position = ORIGIN_TOP_LEFT + (12, 12)
                size = (LEFT_W - 24, 206)
                border_color = #3a3a4a

                @area(preview_renderer) {
                    position = ORIGIN_TOP_LEFT + (16, 10)
                    size = (LEFT_W - 56, 180)
                }
            }

            @text(label_name) {
                position = ORIGIN_TOP_LEFT + (12, 228)
                text = "Name"
                text_scale = 0.8
                colour = #aaaaaa
                halign = fa_left
                valign = fa_middle
            }

            @textbox(input_name) {
                position = ORIGIN_TOP_LEFT + (12, 242)
                size = (FIELD_W, 24)
                placeholder = "name..."
                text_length = 40
            }

            @text(label_voice) {
                position = ORIGIN_TOP_LEFT + (12, 278)
                text = "Noise"
                text_scale = 0.8
                colour = #aaaaaa
                halign = fa_left
                valign = fa_middle
            }

            @dropdown(input_voice) {
                position = ORIGIN_TOP_LEFT + (12, 292)
                size = (FIELD_W, 24)
            }

            @text(label_pitch) {
                position = ORIGIN_TOP_LEFT + (12, 328)
                text = "Pitch"
                text_scale = 0.8
                colour = #aaaaaa
                halign = fa_left
                valign = fa_middle
            }

            @slider(input_pitch) {
                position = ORIGIN_TOP_LEFT + (12, 342)
                size = (FIELD_W, 16)
                min = -100
                max = 100
                value = 0
            }
        }

        @area(right_panel) {
            position = ORIGIN_TOP_LEFT + (PAD + LEFT_W + GAP, PAD + HEADER_H + GAP)
            size = (RIGHT_W, CONTENT_H)
            border_color = #3a3a4a

            @text(label_category) {
                position = ORIGIN_TOP_LEFT + (12, 16)
                text = "Category"
                text_scale = 0.8
                colour = #aaaaaa
                halign = fa_left
                valign = fa_middle
            }

            @area(type_tabs) {
                position = ORIGIN_TOP_LEFT + (12, 30)
                size = (RIGHT_W - 24, 28)
                layout = LAYOUT_HORIZONTAL
                spacing = 8
            }

            @text(label_style) {
                position = ORIGIN_TOP_LEFT + (12, 82)
                text = "Design"
                text_scale = 0.8
                colour = #aaaaaa
                halign = fa_left
                valign = fa_middle
            }

            @area(style_row) {
                position = ORIGIN_TOP_LEFT + (12, 96)
                size = (RIGHT_W - 24, 44)
                layout = LAYOUT_HORIZONTAL
                spacing = 6
            }

            @text(label_design) {
                position = ORIGIN_TOP_LEFT + (12, 158)
                text = "More Designs"
                text_scale = 0.8
                colour = #aaaaaa
                halign = fa_left
                valign = fa_middle
            }

            @scroll_area(design_scroll) {
                position = ORIGIN_TOP_LEFT + (12, 172)
                size = (RIGHT_W - 24, 108)

                @area(design_list) {
                    position = ORIGIN_TOP_LEFT
                    size = (RIGHT_W - 36, 108)
                    layout = LAYOUT_GRID
                    grid_columns = 6
                    spacing = 6
                }
            }

            @text(label_colour) {
                position = ORIGIN_TOP_LEFT + (12, 298)
                text = "Palette"
                text_scale = 0.8
                colour = #aaaaaa
                halign = fa_left
                valign = fa_middle
            }

            @area(colour_row) {
                position = ORIGIN_TOP_LEFT + (12, 312)
                size = (RIGHT_W - 24, 44)
                layout = LAYOUT_GRID
                grid_columns = 6
                spacing = 6
            }
        }

        @area(action_dock) {
            position = ORIGIN_BOTTOM_LEFT + (PAD, -PAD - FOOTER_H)
            size = (FRAME_W - (PAD * 2), FOOTER_H)
            border_color = #3a3a4a

            @button(btn_create_player) {
                position = ORIGIN_TOP_CENTER + (0, 8)
                size = (220, 36)
                text = "Create Player"
            }
        }
    }
}
