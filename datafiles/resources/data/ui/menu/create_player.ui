// create player screen layout

@area(create_player_menu) {
    size = (960, 540)
    position = ORIGIN_CENTER

    @button(btn_back) {
        position = ORIGIN_TOP_LEFT + (24, 24)
        size = (48, 24)
        text = "Back"
    }

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Create Player"
        text_scale = 1.5
    }

    @area(main_content) {
        position = ORIGIN_CENTER + (0, 0)
        size = (880, 360)

        @area(left_column) {
            position = ORIGIN_TOP_LEFT
            size = (280, 360)
            
            @area(preview_renderer) {
                position = ORIGIN_TOP_CENTER + (0, 16)
                size = (200, 240)
            }
        }

		@line(divider) {
			position = ORIGIN_CENTER
			start = (0, -160)
			end = (0, 160)
			thickness = 1
			colour = #3a3a4a
		}

        @area(right_column) {
            position = ORIGIN_TOP_RIGHT
            size = (560, 360)

            @text(label_body_design) {
                position = ORIGIN_TOP_LEFT + (16, 16)
                text = "Body Design"
                text_scale = 0.8
                colour = #aaaaaa
            }

            @area(body_design_row) {
                position = ORIGIN_TOP_LEFT + (16, 36)
                size = (520, 48)
                layout = LAYOUT_HORIZONTAL
                spacing = 8
                // icons injected via GML
            }

            @text(label_colour) {
                position = ORIGIN_TOP_LEFT + (16, 96)
                text = "Color"
                text_scale = 0.8
                colour = #aaaaaa
            }

            @area(colour_row) {
                position = ORIGIN_TOP_LEFT + (16, 116)
                size = (520, 48)
                layout = LAYOUT_HORIZONTAL
                spacing = 8
                // color swatches injected via GML
            }

            @scroll_area(design_scroll) {
                position = ORIGIN_TOP_LEFT + (16, 176)
                size = (520, 180)

                @area(design_list) {
                    position = ORIGIN_TOP_LEFT
                    size = (520, 180)
                }
            }
        }
    }

    @area(bottom_fields) {
        position = ORIGIN_BOTTOM_CENTER + (0, -64)
        size = (880, 32)
        layout = LAYOUT_HORIZONTAL
        spacing = 8

        @textbox(input_name) {
            size = (300, 24)
            placeholder = "name..."
            text_length = 40
        }

        @textbox(input_age) {
            size = (120, 24)
            placeholder = "age..."
        }

        @textbox(input_plan) {
            size = (300, 24)
            placeholder = "plan..."
        }
    }

    @button(btn_create_player) {
        position = ORIGIN_BOTTOM_RIGHT + (-24, -24)
        size = (160, 28)
        text = "Create Player"
    }
}
