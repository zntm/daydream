// worlds screen layout

@area(worlds_menu) {
    size = (640, 480)
    position = ORIGIN_CENTER
	background = #0e0e1a

    @button(btn_back) {
        position = ORIGIN_TOP_LEFT + (8, 8)
        size = (48, 24)
        text = "Back"
    }

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 16)
        text = "Worlds"
        text_scale = 1.5
    }

    @button(btn_view_toggle) {
        position = ORIGIN_TOP_RIGHT + (-8, 8)
        size = (32, 24)
        text = "Grid"
    }

    @area(content_area) {
        position = ORIGIN_CENTER + (0, 16)
        size = (600, 380)

        @scroll_area(worlds_scroll) {
            position = ORIGIN_TOP_LEFT
            size = (600, 380)

            @area(worlds_container) {
                position = ORIGIN_TOP_LEFT
                size = (600, 380)
                layout = LAYOUT_VERTICAL
                spacing = 4

                // pinned section, divider, normal section injected via GML
            }
        }
    }

    @button(btn_create_world) {
        position = ORIGIN_BOTTOM_CENTER + (0, -8)
        text = "Create World"
        size = (180, 28)
    }
}
