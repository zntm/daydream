// worlds screen layout

@area(worlds_menu) {
    size = (960, 540)
    position = ORIGIN_CENTER

    @button(btn_back) {
        position = ORIGIN_TOP_LEFT + (24, 24)
        size = (64, 32)
        text = "Back"
    }

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Worlds"
        text_scale = 1.5
    }

    @button(btn_view_toggle) {
        position = ORIGIN_TOP_RIGHT + (-24, 24)
        size = (56, 32)
        text = "Grid"
    }

    @area(content_area) {
        position = ORIGIN_CENTER + (0, 18)
        size = (888, 392)

        @scroll_area(worlds_scroll) {
            position = ORIGIN_TOP_LEFT
            size = (888, 392)

            @area(worlds_container) {
                position = ORIGIN_TOP_LEFT
                size = (888, 392)
                layout = LAYOUT_VERTICAL
                spacing = 8

                // pinned section, divider, normal section injected via GML
            }
        }
    }

    @button(btn_create_world) {
        position = ORIGIN_BOTTOM_CENTER + (0, -28)
        text = "Create World"
        size = (200, 36)
    }
}
