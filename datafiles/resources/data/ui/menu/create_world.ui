// create world screen layout

var PANEL_WIDTH = 400
var SLIDER_WIDTH = 380
var TEXTBOX_WIDTH = 340
var TEXTBOX_HEIGHT = 20
var BUTTON_HEIGHT = 24
var SECTION_SPACING = 4
var INNER_SPACING = 2

@area(create_world) {
    size = (960, 540)
    position = ORIGIN_CENTER

    @button(btn_back) {
        position = ORIGIN_TOP_LEFT + (24, 24)
        size = (64, 32)
        text = "Back"
    }

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Create World"
        text_scale = 1.5
    }

    @area(main_content) {
        position = ORIGIN_CENTER + (0, 16)
        size = (880, 400)

        @line(divider) {
            position = ORIGIN_TOP_LEFT + (PANEL_WIDTH, 0)
            start = (0, 0)
            end = (0, 400)
            thickness = 1
            colour = #3a3a4a
        }

        @area(left_panel) {
            position = ORIGIN_TOP_LEFT
            size = (PANEL_WIDTH, 400)
            layout = LAYOUT_VERTICAL
            spacing = 8

            @area(name_label_row) {
                size = (PANEL_WIDTH, 14)
                @text(label_name) {
                    text = "name"
                    colour = #aaaaaa
                    text_scale = 0.8
                }
            }

            @area(name_row) {
                size = (PANEL_WIDTH, TEXTBOX_HEIGHT)
                layout = LAYOUT_HORIZONTAL
                spacing = 2

                @textbox(world_name) {
                    size = (TEXTBOX_WIDTH, TEXTBOX_HEIGHT)
                    placeholder = "enter name..."
                    text_length = 40
                }

                @button(btn_randomize_name) {
                    size = (24, TEXTBOX_HEIGHT)
                    icon = "spr_Icon_Random"
                    icon_xscale = 1
                    icon_yscale = 1
                }
            }

        }

        @area(right_panel) {
            position = ORIGIN_TOP_RIGHT
            size = (PANEL_WIDTH, 400)

            @scroll_area(options_scroll) {
                position = ORIGIN_TOP_LEFT
                size = (PANEL_WIDTH, 400)
                layout = LAYOUT_VERTICAL
                spacing = SECTION_SPACING

                @area(difficulty_label_row) {
                    size = (SLIDER_WIDTH, 14)
                    @text(label_difficulty) {
                        text = "difficulty"
                        colour = #aaaaaa
                        text_scale = 0.8
                    }
                }

                @slider(difficulty) {
                    size = (SLIDER_WIDTH, 16)
                    min_value = 0
                    max_value = 4
                    value = 1
                    step = 1
                }

                @button(btn_death_penalty) {
                    text = "death penalty"
                    size = (SLIDER_WIDTH, BUTTON_HEIGHT)
                }

                @area(death_penalty_content) {
                    size = (SLIDER_WIDTH, 60)
                    layout = LAYOUT_VERTICAL
                    spacing = INNER_SPACING
                    visible = false

                    @text(label_item_drop) {
                        text = "item drop %"
                        colour = #aaaaaa
                        text_scale = 0.8
                    }

                    @slider(item_drop_pct) {
                        size = (SLIDER_WIDTH, 16)
                        min_value = 0
                        max_value = 100
                        value = 0
                        step = 5
                    }

                    @text(label_item_durability) {
                        text = "item durability %"
                        colour = #aaaaaa
                        text_scale = 0.8
                    }

                    @slider(item_durability_pct) {
                        size = (SLIDER_WIDTH, 16)
                        min_value = 0
                        max_value = 100
                        value = 0
                        step = 5
                    }
                }

                @button(btn_advanced) {
                    text = "advanced options"
                    size = (SLIDER_WIDTH, BUTTON_HEIGHT)
                }

                @area(advanced_content) {
                    size = (SLIDER_WIDTH, 400)
                    layout = LAYOUT_VERTICAL
                    spacing = SECTION_SPACING
                    visible = false

                    @button(btn_backup) {
                        text = "backup"
                        size = (SLIDER_WIDTH, BUTTON_HEIGHT)
                    }

                    @area(backup_content) {
                        size = (SLIDER_WIDTH, 60)
                        layout = LAYOUT_VERTICAL
                        spacing = INNER_SPACING
                        visible = false

                        @text(label_backup_interval) {
                            text = "backup interval"
                            colour = #aaaaaa
                            text_scale = 0.8
                        }

                        @slider(backup_interval) {
                            size = (SLIDER_WIDTH, 16)
                            min_value = 0
                            max_value = 60
                            value = 0
                            step = 5
                        }

                        @text(label_backup_slots) {
                            text = "backup slots"
                            colour = #aaaaaa
                            text_scale = 0.8
                        }

                        @slider(backup_slots) {
                            size = (SLIDER_WIDTH, 16)
                            min_value = 0
                            max_value = 10
                            value = 0
                            step = 1
                        }
                    }

                    @text(label_permissions) {
                        text = "permissions"
                        colour = #aaaaaa
                        text_scale = 0.8
                    }

                    @dropdown(permissions) {
                        size = (SLIDER_WIDTH, 16)
                        choices = ("none", "min", "max")
                        choice_index = 0
                    }

                    @button(btn_game_rules) {
                        text = "game rules"
                        size = (SLIDER_WIDTH, BUTTON_HEIGHT)
                    }

                    @area(game_rules_content) {
                        size = (SLIDER_WIDTH, 300)
                        layout = LAYOUT_VERTICAL
                        spacing = INNER_SPACING
                        visible = false

                        @text(label_advance_time) {
                            text = "advance time"
                            colour = #aaaaaa
                            text_scale = 0.8
                        }

                        @slider(advance_time) {
                            size = (SLIDER_WIDTH, 16)
                            min_value = 0
                            max_value = 32
                            value = 1
                            step = 1
                        }

                        @text(label_friendly_fire) {
                            text = "friendly fire"
                            colour = #aaaaaa
                            text_scale = 0.8
                        }

                        @radio_button(friendly_fire) {
                            text = "enabled"
                            size = (SLIDER_WIDTH, 16)
                            selected = false
                        }

                        @button(btn_item_drops) {
                            text = "item drops"
                            size = (SLIDER_WIDTH, BUTTON_HEIGHT)
                        }

                        @area(item_drops_content) {
                            size = (SLIDER_WIDTH, 40)
                            layout = LAYOUT_VERTICAL
                            spacing = INNER_SPACING
                            visible = false

                            @radio_button(entity_drops) {
                                text = "entity drops"
                                size = (SLIDER_WIDTH, 16)
                                selected = false
                            }

                            @radio_button(tile_drops) {
                                text = "tile drops"
                                size = (SLIDER_WIDTH, 16)
                                selected = false
                            }
                        }

                        @text(label_natural_regen) {
                            text = "natural regeneration"
                            colour = #aaaaaa
                            text_scale = 0.8
                        }

                        @slider(natural_regen) {
                            size = (SLIDER_WIDTH, 16)
                            min_value = 0
                            max_value = 4
                            value = 1
                            step = 1
                        }
                    }
                }
            }
        }
    }

    @area(bottom_fields) {
        position = ORIGIN_BOTTOM_LEFT + (40, -36)
        size = (PANEL_WIDTH - 40, TEXTBOX_HEIGHT)
        layout = LAYOUT_HORIZONTAL
        spacing = 2

        @textbox(world_seed) {
            size = (TEXTBOX_WIDTH, TEXTBOX_HEIGHT)
            placeholder = "enter seed..."
        }

        @button(btn_randomize_seed) {
            size = (24, TEXTBOX_HEIGHT)
            icon = "spr_Icon_Random"
            icon_xscale = 1
            icon_yscale = 1
        }
    }

    @button(btn_create_world) {
        position = ORIGIN_BOTTOM_RIGHT + (-24, -24)
        text = "create world"
        size = (200, 32)
    }
}
