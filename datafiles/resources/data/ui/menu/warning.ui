// warning screen layout

@area(warning_screen) {
    size = (960, 540)
    position = ORIGIN_CENTER

    @text(label_header) {
        position = ORIGIN_CENTER + (0, -40)
        text = *header
        text_scale = 4
    }

    @text(label_description) {
        position = ORIGIN_CENTER + (0, 32)
        text = *description
    }
}
