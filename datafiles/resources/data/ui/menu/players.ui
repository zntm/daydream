// players screen layout

@area(players_menu) {
    size = (960, 540)
    position = ORIGIN_CENTER

    @button(btn_back) {
        position = ORIGIN_TOP_LEFT + (24, 24)
        size = (64, 32)
        text = "Back"
    }

    @text(title) {
        position = ORIGIN_TOP_CENTER + (0, 32)
        text = "Players"
        text_scale = 1.5
    }

    @button(btn_view_toggle) {
        position = ORIGIN_TOP_RIGHT + (-24, 24)
        size = (56, 32)
        text = "Grid"
    }

    @area(content_area) {
        position = ORIGIN_CENTER + (0, 18)
        size = (888, 392)

        @scroll_area(players_scroll) {
            position = ORIGIN_TOP_LEFT
            size = (888, 392)

            @area(players_container) {
                position = ORIGIN_TOP_LEFT
                size = (888, 392)
                layout = LAYOUT_VERTICAL
                spacing = 8

                // pinned section label injected via GML
                // pinned cards injected via GML
                // divider injected via GML
                // normal section label injected via GML
                // normal cards injected via GML
            }
        }
    }

    @button(btn_create_player) {
        position = ORIGIN_BOTTOM_CENTER + (0, -28)
        text = "Create Player"
        size = (200, 36)
    }
}
