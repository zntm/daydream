// title screen layout

@area(title_menu) {
    size = (960, 540)
    position = ORIGIN_CENTER

    @area(title_graphic) {
        position = ORIGIN_TOP_CENTER + (0, 52)
        size = (0, 0)
    }

    @area(menu_options) {
        position = ORIGIN_CENTER + (0, 92)
        size = (224, 168)
        layout = LAYOUT_VERTICAL
        spacing = 16

        @button(btn_play) {
            text = "Play"
            size = (224, 40)
        }

        @button(btn_settings) {
            text = "Settings"
            size = (224, 40)
        }

		@area(bottom_buttons) {
			size = (224, 40)
			layout = LAYOUT_HORIZONTAL
			spacing = 16

			@button(btn_credits) {
				text = "Credits"
				size = (104, 40)
			}

			@button(btn_exit) {
				text = "Exit"
				size = (104, 40)
			}
		}
    }

    @area(socials) {
        position = ORIGIN_BOTTOM_LEFT + (24, -24)
        size = (112, 32)
        layout = LAYOUT_HORIZONTAL
        spacing = 8
        
        @button(btn_twitter) {
            size = (32, 32)
        }

        @button(btn_bluesky) {
            size = (32, 32)
        }

        @button(btn_discord) {
            size = (32, 32)
        }
    }

    @area(version_anchor) {
        position = ORIGIN_BOTTOM_RIGHT + (-24, -24)
        size = (0, 0)
        
        @area(version_graphic) {
            position = ORIGIN_CENTER
            size = (0, 0)
        }
    }
}
