// title screen layout

var PANEL_W = 404
var PANEL_H = 390
var PANEL_PAD = 20
var STACK_W = 240
var STACK_H = 220
var STACK_GAP = 12

@area(title_menu) {
    size = (960, 540)
    position = ORIGIN_MIDDLE_CENTER

    @area(screen_frame) {
        position = ORIGIN_MIDDLE_CENTER + (0, 6)
        size = (PANEL_W, PANEL_H)

        @area(title_block) {
            position = ORIGIN_TOP_LEFT + (PANEL_PAD, PANEL_PAD)
            size = (PANEL_W - (PANEL_PAD * 2), 140)

            @area(title_graphic) {
                position = ORIGIN_TOP_CENTER + (0, 20)
                size = (0, 0)
            }
        }

        @area(menu_options) {
            position = ORIGIN_TOP_CENTER + (0, 156)
            size = (STACK_W, STACK_H)
            layout = LAYOUT_VERTICAL
            spacing = STACK_GAP

            @button(btn_play) {
                text = "Play"
                size = (STACK_W, 40)
            }

            @button(btn_settings) {
                text = "Settings"
                size = (STACK_W, 40)
            }

            @button(btn_credits) {
                text = "Credits"
                size = (STACK_W, 40)
            }

            @button(btn_exit) {
                text = "Exit"
                size = (STACK_W, 40)
            }
        }

        @area(version_anchor) {
            position = ORIGIN_BOTTOM_RIGHT + (-18, -14)
            size = (0, 0)

            @area(version_graphic) {
                position = ORIGIN_MIDDLE_CENTER
                size = (0, 0)
            }
        }
    }
}
