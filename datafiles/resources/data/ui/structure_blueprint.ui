// Structure Blueprint UI
// Used in structure editor mode for defining structure bounds and metadata

var _padding = 8
var _spacing = 6

@window(structure_blueprint) {
    size = (280, 320)
    position = (8, 100)
    movable = true
    resizable = false
    title = "Structure Blueprint"
    background = #1a1a2e
    
    @area(content) {
        padding = _padding
        layout = LAYOUT_VERTICAL
        spacing = _spacing
        
        @text(title_label) {
            text = "Structure ID:"
            colour = #aaaaaa
            text_scale = 0.8
        }
        
        @textbox(id_input) {
            size = (260, 24)
            text = *structure_id
            placeholder = "namespace:structure/name"
        }
        
        @text(offset_label) {
            text = "Offset (x, y):"
            colour = #aaaaaa
            text_scale = 0.8
        }
        
        @area(offset_row) {
            layout = LAYOUT_HORIZONTAL
            spacing = 8
            
            @textbox(xoffset_input) {
                size = (120, 24)
                mode = "integer"
                text = *xoffset
                placeholder = "0"
            }
            
            @textbox(yoffset_input) {
                size = (120, 24)
                mode = "integer"
                text = *yoffset
                placeholder = "0"
            }
        }
        
        @text(scale_label) {
            text = "Scale (w, h):"
            colour = #aaaaaa
            text_scale = 0.8
        }
        
        @area(scale_row) {
            layout = LAYOUT_HORIZONTAL
            spacing = 8
            
            @textbox(xscale_input) {
                size = (120, 24)
                mode = "integer"
                text = *xscale
                placeholder = "1"
            }
            
            @textbox(yscale_input) {
                size = (120, 24)
                mode = "integer"
                text = *yscale
                placeholder = "1"
            }
        }
        
        @text(turns_into_label) {
            text = "Turns Into:"
            colour = #aaaaaa
            text_scale = 0.8
        }
        
        @textbox(turns_into_input) {
            size = (260, 24)
            text = *turns_into
            placeholder = "namespace:tile/name"
        }
        
        @area(button_row) {
            layout = LAYOUT_HORIZONTAL
            spacing = 8
            
            @button(export_btn) {
                text = "Export"
                size = (120, 28)
                on_select_release = "@phantasia:blueprint/export_structure"
            }
            
            @button(cancel_btn) {
                text = "Cancel"
                size = (120, 28)
                on_select_release = "@phantasia:blueprint/cancel"
            }
        }
    }
}
