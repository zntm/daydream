{
    "inventory": "#phantasia:item/generic/inventory_default",
    "sprite": "phantasia:item/loot_blueprint",
    "tile": {
        "audio_properties": {
            "lowpass": 0.65,
            "reverb": 0.5
        },
        "components": {
            "id": {
                "default": "",
                "max": 80,
                "min": 0,
                "type": "string"
            },
            "turns_into": {
                "default": "",
                "max": 80,
                "min": 0,
                "type": "string"
            }
        },
        "on_use": [
            {
                "id": "@phantasia:open_ui",
                "parameters": {
                    "ui": "ui/loot_blueprint.ui",
                    "definition": "loot_blueprint_menu",
                    "bindings": {
                        "id": "component:id",
                        "turns_into": "component:turns_into"
                    }
                }
            }
        ],
        "sfx": "#phantasia:tile/sfx/stone"
    },
    "type": "solid"
}