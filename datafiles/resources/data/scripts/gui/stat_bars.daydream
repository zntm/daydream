import hp_container, stamina_container from "ui/stat_bars.ui"

var player = parameter.player
var parent = parameter.parent

ui_spawn([hp_container, stamina_container], {
    parent: parent,
    link: {
        hp_value: () -> player.hp,
        hp_max: () -> player.hp_max,
        stamina_value: () -> player.stamina,
        stamina_max: () -> player.stamina_max,
    }
})