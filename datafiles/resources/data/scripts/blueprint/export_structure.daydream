import { structure_blueprint } from "ui/structure_blueprint.ui"

// tile is provided in the context
var t = tile

// This logic is adapted from the old export_structure.daydream
// but integrated with the new declarative UI context

var structure_id = t.get_component("id")
if (structure_id == undefined || structure_id == "") {
    show_debug_message("Error: Structure ID is empty");
    return;
}

// Perform export logic...
show_debug_message("Exporting structure: " + structure_id);

// After success, close the UI
if (element != undefined && element.instance != undefined) {
    ui_destroy(element.instance);
}
