// Handles crop growth based on heat/humidity and time

import gaussian_distribution from "./modules/gaussian_distribution.daydream"

var _data = get_item(tile.id);
var _crop = _data.get_crop();

var _heat_peak    = _crop.condition.heat.peak;
var _heat_falloff = _crop.condition.heat.falloff;

var _bonus_heat = max(0.01, gaussian_distribution(
    worldgen_get_heat(x, y, WORLD_SEED),
    _heat_peak,
    _heat_falloff
)) * random_range(0.9, 1.1);

// Assuming 'tile' is the tile struct/object passed in context
var _growth_time = tile.variable.growth_time;
var _maturity_limit = _crop.maturity_limit;

if (_growth_time < _maturity_limit)
{
    var n = min(_growth_time + _bonus_heat, _maturity_limit);
    
    tile.variable.growth_time = n;
    
    var _animation_index_min = _crop.animation.index_min;
    var _animation_index_max = _crop.animation.index_max;
    
    var _index_offset = _animation_index_min + floor(n * (_animation_index_max - 1 - _animation_index_min));
    
    tile.set_index_offset(_index_offset);
    
    return;
}
