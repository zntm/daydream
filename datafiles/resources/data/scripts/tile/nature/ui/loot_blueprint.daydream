import { loot_blueprint } from "ui/loot_blueprint.ui"

// 'tile', 'x', 'y', 'z' are provided by the engine when running a tile script
var t = tile

var state = {
    entries: [],
    preview: fn() {
        if (array_length(entries) == 0) {
            return "No entries added yet."
        }

        var text = "Queued Entries:\n"

        for (var i = 0; i < array_length(entries); ++i) {
            var entry = entries[i]
            var amount_text = (entry.amount_min == entry.amount_max)
                ? string(entry.amount_min)
                : string(entry.amount_min) + "-" + string(entry.amount_max)

            text += string(i + 1) + ". "
            text += entry.item_id
            text += " x" + amount_text
            text += " (weight " + string(entry.weight) + ")"

            if (i < array_length(entries) - 1) {
                text += "\n"
            }
        }

        return text
    }
}

// Spawn the UI instance with data bindings
var instance = ui_spawn(loot_blueprint, {
    link: {
        loot_id: fn() { return t.get_component("id") },
        rolls_min: fn() { return 1 },
        rolls_max: fn() { return 1 },
        item_id: fn() { return "" },
        amount_min: fn() { return 1 },
        amount_max: fn() { return 1 },
        weight: fn() { return 1 },
        entries_preview: fn() { return state.preview() },
        tile_x: x,
        tile_y: y,
        tile_z: z
    }
})

instance.link_context.state = state
