if chance(0.6) {
    spawn_particle(parameter.id, x, y)
}

if !tile?.get_component("natural") {
    print("Leaf decay: not natural")
    return
}

// Extremely simple random tick logic: only decay if marked as decaying.
// No wood check here anymore, as requested by the user.
if tile.get_component("decaying") {
    tile_place(undefined, x, y, z)

    repeat 12 {
        spawn_particle(parameter.id, x, y)
    }
}