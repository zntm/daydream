if (!tile?.get_component("natural")) {
    return
}

var wood = tag_get("phantasia:tile/generic/wood")

var RADIUS = 4

for (var dx in -RADIUS..RADIUS) {
    for (var dy in -RADIUS..RADIUS) {
        if (abs(dx) + abs(dy) > RADIUS) {
            continue
        }
    
        var t = tile_get(x + dx, y + dy, z - 1)

        if (t?.get_id() in wood) {
            if (chance(0.6)) {
                spawn_particle("phantasia:tile/leaf/oak", x, y)
            }
            
            return
        }
    }
}

tile_place(undefined, x, y, z)

repeat (12) {
    spawn_particle("phantasia:tile/leaf/oak", x, y)
}