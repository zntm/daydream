test_group("values", [
    test("typeof string", fn() {
        test_expect(typeof("hello"), "string")
    }),
    test("typeof number", fn() {
        test_expect(typeof(5), "number")
    }),
    test("typeof boolean", fn() {
        test_expect(typeof(true), "boolean")
    }),
    test("typeof array", fn() {
        test_expect(typeof([1, 2, 3]), "array")
    }),
    test("typeof object", fn() {
        class MyClass {}

        test_expect(typeof(MyClass), "object")
    }),
    test("typeof function", fn() {
        test_expect(typeof(fn() {}), "function")
    }),
    test("typeof undefined", fn() {
        test_expect(typeof(undefined), "undefined")
    }),
    test("typeof regex", fn() {
        test_expect(typeof(/abc/gi), "regex")
    }),
    test("typeof struct", fn() {
        test_expect(typeof({ a: 1, b: 2 }), "struct")
    }),
])
