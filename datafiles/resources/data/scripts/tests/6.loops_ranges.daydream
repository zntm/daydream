test_group("loops_ranges", [
    test("for_loops", fn() {
        var struct = { a: 1, b: 2, c: 3 }
        
        // 1. for (k, v in struct)
        var keys = []
        var vals = []

        for (var k, v in struct) {
            array_push(keys, k)
            array_push(vals, v)
        }

        test_expect(array_length(keys), 3)
        test_expect("a" in keys, true)
        test_expect("b" in keys, true)
        test_expect("d" in keys, false)
        
        test_expect(1 in vals, true)
        test_expect(2 in vals, true)
        test_expect(4 in vals, false)

        // 2. for (k in key struct)
        var keys_only = []
        for (var k in key struct) {
            array_push(keys_only, k)
        }
        test_expect(array_length(keys_only), 3)
        test_expect("a" in keys_only, true)
        
        // 3. for (v in value struct)
        var vals_only = []
        for (var v in value struct) {
            array_push(vals_only, v)
        }
        test_expect(array_length(vals_only), 3)
        test_expect(1 in vals_only, true)
        
        // 4. for (v in struct) - Default behavior (Values) -> SHOULD ERROR
        var caught = false
        try {
            var vals_default = []
            for (var v in struct) {
                array_push(vals_default, v)
            }
        } catch (e) {
            caught = true
        }
        test_expect(caught, true)
        
        // 5. Array Iteration
        var arr = [10, 20, 30]
        var arr_vals = []
        for (var x in arr) {
            array_push(arr_vals, x)
        }
        test_expect(arr_vals[0], 10)
        test_expect(arr_vals[2], 30)
        
        // 6. Array Index+Value
        var indices = []
        var values = []
        for (var i, v in arr) {
            array_push(indices, i)
            array_push(values, v)
        }
        test_expect(indices[0], 0)
        test_expect(indices[2], 2)
        test_expect(values[0], 10)
    }),
    test("array_ranges", fn() {
        var arr = [0, 1, 2, 3, 4, 5]
        
        // 1. Basic slice
        var slice1 = arr[1..3] // [1, 2, 3]
        test_expect(array_length(slice1), 3)
        test_expect(slice1[0], 1)
        test_expect(slice1[2], 3)
        
        // 2. Clamped slice
        var slice2 = arr[4..10] // [4, 5]
        test_expect(array_length(slice2), 2)
        test_expect(slice2[0], 4)
        test_expect(slice2[1], 5)
        
        // 3. Full slice
        var slice3 = arr[0..5]
        test_expect(array_length(slice3), 6)
        test_expect(slice3[5], 5)
        
        // 4. Invalid range (start > end) -> Empty
        var slice4 = arr[3..1]
        test_expect(array_length(slice4), 0)
        
        // 5. Negative start (clamped to 0)
        var slice5 = arr[-2..1] // [0, 1]
        test_expect(array_length(slice5), 2)
        test_expect(slice5[0], 0)
    })
])