test_group("Proglang New Features", [
    test("in operator - string", fn() {
        test_expect("a" in "abc", true)
        test_expect("d" in "abc", false)
        test_expect("world" in "hello world", true)
    }),
    test("in operator - array", fn() {
        var arr = [1, 2, 3, 5]
        test_expect(2 in arr, true)
        test_expect(4 in arr, false)
        test_expect(5 in arr, true)
        test_expect("a" in arr, false)
    }),
    test("in operator - struct modifiers", fn() {
        var obj = { name: "Alice", age: 30, role: "admin" }
        
        // key modifier
        test_expect("name" in key obj, true)
        test_expect("Alice" in key obj, false)
        
        // value modifier
        test_expect("Alice" in value obj, true)
        test_expect("Bob" in value obj, false)
        test_expect(30 in value obj, true)
        test_expect("name" in value obj, false)
    }),
    test("range loops (..)", fn() {
        var sum = 0
        // standard range
        for (var i in 1..5) {
            sum += i
        }
        test_expect(sum, 1 + 2 + 3 + 4 + 5) // 15
        
        var count = 0
        // Loop not entering
        for (var i in 5..1) {
            count += 1
        }
        test_expect(count, 0)
        
        // Single iteration
        var single = 0
        for (var i in 1..1) {
            single += 1
        }
        test_expect(single, 1)
    }),
    test("optional chaining (?.)", fn() {
        var obj = { a: { b: 10 } }
        var nullObj = undefined
        
        test_expect(obj?.a?.b, 10)
        test_expect(obj?.a?.c, undefined)
        test_expect(nullObj?.a, undefined)
        test_expect(nullObj?.a?.b, undefined)
    }),
    test("optional indexing (?[ ])", fn() {
        var arr = [1, [2, 3]]
        var nullArr = undefined
        
        test_expect(arr?.[0], 1)
        test_expect(arr?.[1]?.[0], 2)
        test_expect(nullArr?.[0], undefined)
        
        var obj = { data: [10, 20] }
        test_expect(obj?.data?.[1], 20)
        test_expect(obj?.missing?.[0], undefined)
    }),
    test("string key access", fn() {
        var obj = { name: "Test" }
        var key = "name"
        test_expect(obj["name"], "Test")
        test_expect(obj[key], "Test")
        
        // Setting via string key
        obj["age"] = 25
        test_expect(obj.age, 25)
    }),
    test("inline simple", fn() {
        @inline
        fn add(a, b) {
            return a + b;
        }
        
        test_expect(add(10, 20), 30)
    }),
    test("inline scope", fn() {
        var x = 10;
        @inline
        fn foo() {
            var x = 20;
            return x;
        }
        
        test_expect(foo() + x, 30)
    }),
    test("inline early return", fn() {
        @inline
        fn check(v) {
            if (v) return 1;
            return 0;
        }
        
        test_expect(check(true) + check(false), 1)
    })
])
/*
@inline fn add(a, b) { return a + b; } return add(10, 20)

    if (_assert("Inline Simple", "@inline fn add(a, b) { return a + b; } return add(10, 20)", 30)) _passed++; else _failed++;
    if (_assert("Inline Scope", "var x = 10; @inline fn foo() { var x = 20; return x; } return foo() + x", 30)) _passed++; else _failed++;
    if (_assert("Inline Early Return", "@inline fn check(v) { if (v) return 1; return 0; } return check(true) + check(false)", 1)) _passed++; else _failed++;
