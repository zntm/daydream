test_group("classes", [
    test("constructor returns an instance and preserves caller state", fn() {
        class Counter {
            fn constructor(value) {
                this.value = value
            }

            fn read() {
                return this.value
            }
        }

        var before = 5
        var counter = new Counter(12)
        var after = before + 1

        test_expect(counter.value, 12)
        test_expect(counter.read(), 12)
        test_expect(after, 6)
    }),

    test("methods bind this per instance", fn() {
        class Box {
            fn constructor(value) {
                this.value = value
            }

            fn get() {
                return this.value
            }
        }

        var a = new Box(1)
        var b = new Box(2)

        test_expect(a.get(), 1)
        test_expect(b.get(), 2)
    }),

    test("closures created inside methods keep the receiver", fn() {
        class Reader {
            fn constructor(value) {
                this.value = value
            }

            fn make_reader() {
                return fn() {
                    return this.value
                }
            }
        }

        var reader = new Reader(42)
        var read = reader.make_reader()

        test_expect(read(), 42)
    }),

    test("super resolves across constructors and methods", fn() {
        class Animal {
            fn constructor(name) {
                this.name = name
            }

            fn label() {
                return this.name
            }
        }

        class Dog extends Animal {
            fn constructor(name, breed) {
                super(name)
                this.breed = breed
            }

            fn label() {
                return super.label() + " (" + this.breed + ")"
            }
        }

        var dog = new Dog("Buddy", "Golden")

        test_expect(dog.label(), "Buddy (Golden)")
    }),
])
