// Minimal test cases to isolate stack underflow

// 1. Simple Call
test_expect(1, 1)

// 2. Closure Creation and Call
var f = fn() { return 2; }
test_expect(f(), 2)

// 3. Array Creation
var arr = [1, 2, 3]
test_expect(arr[0], 1)

// 4. Test Helper Call
test("simple", fn() {
    test_expect(10, 10)
})

// 5. Test Group (Array New + Call)
test_group("debug_group", [
    test("inner", fn() { test_expect(5, 5) })
])
