var a = 10;
var b = 20;
var c = a + b; // Should be 30. If inlined, 'c' receives 30 directly.

var str1 = "Hello";
var str2 = " World";
var str3 = str1 + str2; // Should be "Hello World"

var bool1 = true;
var bool2 = false;
var bool3 = bool1 || bool2; // Should be true

var x = 100;
if (true) {
    x = 200;
}
// After this, 'x' should NOT be assumed constant 100 or 200 by the compiler (invalidation check)
var y = x; 

// Output results to verify correctness
print(c);
print(str3);
print(bool3);
print(y);
