test_group("array utils", [
    test("array insert", fn() {
        var a = [1, 3]
        array_insert(a, 1, 2) // insert 2 at index 1
        test_expect(a[1], 2)
        test_expect(array_length(a), 3)
    }),

    test("array delete", fn() {
        var a = [10, 20, 30]
        array_delete(a, 1, 1) // remove element at index 1
        test_expect(a[1], 30)
        test_expect(array_length(a), 2)
    }),

    test("array sort", fn() {
        var a = [5, 1, 4, 2, 8]
        array_sort(a)
        test_expect(a[0], 1)
        test_expect(a[4], 8)
    }),
])
