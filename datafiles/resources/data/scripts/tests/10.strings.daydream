test_group("string utils", [
    test("upper and lower", fn() {
        test_expect(string_upper("AbC"), "ABC")
        test_expect(string_lower("AbC"), "abc")
    }),

    test("replace all", fn() {
        test_expect(string_replace_all("a b a", "a", "x"), "x b x")
    }),

    test("substring / copy / pos", fn() {
        var s = "hello world"
        test_expect(string_copy(s, 7, 5), "world")
        // string_pos(needle, haystack) should return 1-based position
        test_expect(string_pos("lo", "hello"), 4)
        test_expect(substring("abcdef", 2, 3), "bc")
    }),
])
