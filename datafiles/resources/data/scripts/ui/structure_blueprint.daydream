import { structure_blueprint } from "ui/structure_blueprint.ui"

// 'tile', 'x', 'y', 'z' are provided by the engine when running a tile script
var t = tile

// Spawn the UI instance with data bindings
var instance = ui_spawn(structure_blueprint, {
    link: {
        // Bi-directional bindings for textboxes
        structure_id: fn() { return t.get_component("id") },
        xoffset: fn() { return t.get_component("xoffset") },
        yoffset: fn() { return t.get_component("yoffset") },
        xscale: fn() { return t.get_component("xscale") },
        yscale: fn() { return t.get_component("yscale") },
        turns_into: fn() { return t.get_component("turns_into") },
        
        // Context variables often useful in event handlers
        tile_x: x,
        tile_y: y,
        tile_z: z
    }
})

// The UI instance is now registered in global.ui_instances 
// and will be updated/drawn by the central UI manager.
