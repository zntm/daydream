var selected_index = INVENTORY.SELECTED_INDEX()
var held_item = inventory_get("player", "base", selected_index)
if (held_item == undefined) return

var liquid_id = parameter.liquid_id
if (liquid_id == undefined) return

var liquid_z = CHUNK_DEPTH.LIQUID

var bucket_level = held_item.variable.level ?? 8

var existing = tile_get(x, y, liquid_z)

if (existing != undefined) {
    if (existing.id == liquid_id) {
        var existing_level = existing.variable.level ?? 0
        var total = existing_level + bucket_level
        var new_level = min(total, 8)
        var remaining = total - new_level
        
        existing.variable.level = new_level
        tile_update_surrounding(x, y, liquid_z)
        
        liquid_flow_start(x, y, liquid_z, parameter)
        
        if (remaining <= 0) {
            var empty_bucket_id = parameter.empty_bucket_id ?? "phantasia:bucket"
            inventory_set("player", "base", selected_index, new Inventory(empty_bucket_id, 1))
        } else {
            held_item.variable.level = remaining
        }
        
        var sound = parameter.sound ?? "phantasia:sfx/liquid/bucket_empty"
        sfx_diegetic_play(undefined, x * TILE_SIZE, y * TILE_SIZE, smart_value(sound))
    }
    return
}

var liquid_tile = new Tile(liquid_id)
liquid_tile.variable.level = bucket_level
liquid_tile.variable.flow_direction = 0

tile_place(liquid_tile, x, y, liquid_z)

liquid_flow_start(x, y, liquid_z, parameter)

var empty_bucket_id = parameter.empty_bucket_id ?? "phantasia:bucket"
inventory_set("player", "base", selected_index, new Inventory(empty_bucket_id, 1))

var sound = parameter.sound ?? "phantasia:sfx/liquid/bucket_empty"
sfx_diegetic_play(undefined, x * TILE_SIZE, y * TILE_SIZE, smart_value(sound))
