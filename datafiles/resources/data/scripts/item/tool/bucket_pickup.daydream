var selected_index = INVENTORY.SELECTED_INDEX()
var held_item = inventory_get("player", "base", selected_index)
if (held_item == undefined) return

var bucket_id = parameter.bucket_id ?? "phantasia:bucket"

if (held_item.id != bucket_id) return

var liquid_z = CHUNK_DEPTH.LIQUID

var liquid_tile = tile_get(x, y, liquid_z)
if (liquid_tile == undefined) return

var tile_id = liquid_tile.id

var level = liquid_tile.variable.level ?? 8

var filled_bucket_id = parameter.filled_bucket_id ?? (tile_id + "_bucket")

var filled_bucket = new Inventory(filled_bucket_id, 1)
filled_bucket.variable.level = level

inventory_set("player", "base", selected_index, filled_bucket)

tile_place(undefined, x, y, liquid_z)

var sound = parameter.sound ?? "phantasia:sfx/liquid/bucket_fill"
sfx_diegetic_play(undefined, x * TILE_SIZE, y * TILE_SIZE, smart_value(sound))
