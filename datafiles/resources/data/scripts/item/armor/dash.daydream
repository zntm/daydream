// Dash ability - triggered by double-pressing left/right movement
// Used by armor/accessories with on_double_horizontal_move

print("[Dash] Script started")

var stamina_cost = parameter.stamina_cost ?? 15
var velocity = parameter.velocity ?? 15

// caller is passed from function_execute.gml
if (caller == undefined) {
    print("[Dash] Caller is undefined!")
    return
}

// Check stamina
var current_stamina = entity_get_stamina(caller)
print("[Dash] Stamina: " + string(current_stamina) + " / " + string(stamina_cost))

if (current_stamina < stamina_cost) {
    print("[Dash] Insufficient stamina")
    return
}

// Consume stamina
entity_set_stamina(caller, current_stamina - stamina_cost)

// Apply velocity burst in the dash direction
// xscale is the dash direction (-1 for left, 1 for right) passed from control_player
print("[Dash] Applying velocity: " + string(xscale * velocity))
entity_set_velocity(caller, xscale * velocity, -3) // Small upward hop (-3) for better feel
entity_set_dash_timer(caller, 0.25) // Prevent friction for 15 frames

// Visual feedback
// Context x, y are now pixel coordinates (after my function_execute caller fix)
// spawn_particle expects TILE coordinates, so we divide by TILE_SIZE
spawn_particle("phantasia:entity/dash", x / 16, y / 16) 

// Camera shake
camera_shake(3)

// Sound effect
sfx_play("phantasia:sfx/event/dash", 0.7)
print("[Dash] Complete")
