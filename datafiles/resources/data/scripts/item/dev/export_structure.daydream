var tile_obj = tile_get(x, y, z)

if (tile_obj == undefined) {
    print("[Blueprint] No structure blueprint tile found.")
    return
}

var result = blueprint_export_structure(
    x,
    y,
    tile_obj.get_component("id"),
    tile_obj.get_component("xoffset") ?? 0,
    tile_obj.get_component("yoffset") ?? 0,
    tile_obj.get_component("xscale") ?? 1,
    tile_obj.get_component("yscale") ?? 1,
    tile_obj.get_component("turns_into") ?? ""
)

if (!result.ok) {
    print("[Blueprint]", result.error)
    return
}

print("[Blueprint] Exported structure:", result.dat_path)
