var sprites = parameter.sprites
var count = parameter.count ?? 8

repeat count {
    if (array_length(sprites) > 0) {
        var idx = irandom(array_length(sprites) - 1)
        var sprite = sprites[idx]
        
        cloud_spawn(
            sprite,
            random(parameter.camera_width * 2),
            random_range(parameter.y_min, parameter.y_max),
            random_range(parameter.scale_min, parameter.scale_max),
            random_range(parameter.alpha_min, parameter.alpha_max),
            random_range(parameter.speed_min, parameter.speed_max)
        )
    }
}

// Subscribe to potential events
event_subscribe("world_blood_moon", fn(_data) {
    cloud_set_tint("#F00")
})

event_subscribe("world_blood_moon_end", fn(_data) {
    cloud_set_tint("#FFF")
})

event_subscribe("background_render", fn(_data) {
    var celestial = celestial_get_active(_data.time)
    
    if (celestial != undefined) {
        var t = celestial.t
        var sprite = celestial.id
        
        var sprite_width = sprite_get_width(sprite)
        
        var start_x = _data.camera_x - sprite_width
        var end_x = _data.camera_x + _data.camera_width + sprite_width
        
        var x = lerp(start_x, end_x, t)
        var y = _data.camera_y + 32
        
        draw_sprite(sprite, 0, x, y)
    }
})
