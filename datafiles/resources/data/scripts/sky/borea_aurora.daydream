var colors = ["#4ECCA3", "#45EBA5", "#21BF73", "#B0EACD"]
var layers = 3

event_subscribe("background_render", fn(_data) {
    if (_data.biome_script != "phantasia:sky/borea_aurora") return

    var time = _data.time / 5000
    var blend = _data.blend ?? 1.0
    
    // Check if it's night (time is 0..1 circular, but current_world.time is likely in frames or seconds)
    // Actually, celestial system might have better time awareness. 
    // For now, let's assume we want it visible or slightly visible depending on some time factor if we can find it.
    // However, the prompt implies we just want it in Borea.
    
    for (var i = 0; i < layers; i++) {
        var layer_time = time + (i * 0.5)
        var alpha = (0.2 + (0.1 * i)) * blend
        
        // Use noise3d for wave motion
        // x/y are camera space or screen space? data.camera_x is passed.
        // Let's use screen space for the pattern but offset by camera for parallax if needed.
        // Actually, aurora is usually very far, so static screen space with noise-based shifting is fine.
        
        var count = 20
        var width = _data.camera_width / count
        
        for (var j = 0; j <= count; j++) {
            var nx = j / count
            var ny = i / layers
            
            // Noise params: x, y, z
            var val = noise3d(nx * 2, ny * 2, layer_time, 2, 1)
            var h_offset = val * 50
            var height = 100 + (val * 150)
            
            var px = _data.camera_x + (j * width)
            var py = _data.camera_y + 50 + (i * 30) + h_offset
            
            draw_set_color(colors[i % array_length(colors)])
            draw_set_alpha(alpha * (1.0 - (j / count) * 0.5)) // Fade slightly to one side
            
            // Draw a vertical strip
            draw_rectangle(px, py, px + width, py + height, false)
        }
    }
    
    draw_set_alpha(1.0)
})
