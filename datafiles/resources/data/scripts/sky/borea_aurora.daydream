var colors = ["#4ECCA3", "#45EBA5", "#21BF73", "#B0EACD"]
var sprite = "phantasia:background/effect/aurora"
var columns = 18
var layers = 3

event_subscribe("background_render", fn(_data) {
    var time = _data.time / 5000
    var blend = _data.blend ?? 1.0

    var col_width = _data.camera_width / columns

    for (var i = 0; i < layers; i++) {
        var layer_speed = 0.3 + (i * 0.15)
        var layer_t = time * layer_speed + (i * 2.1)
        var base_alpha = (0.15 + (0.08 * i)) * blend
        var color = colors[i % array_length(colors)]
        var y_scale = 4 + i * 1.5

        for (var j = 0; j <= columns; j++) {
            var phase = (j / columns) * 3.14159 * 2 + layer_t
            var y_offset = sin(phase) * 30 + sin(phase * 0.7 + 1.3) * 15
            var alpha = base_alpha * (0.5 + 0.5 * sin(phase * 0.5 + 0.8))

            var px = _data.camera_x + (j * col_width)
            var py = _data.camera_y + 20 + (i * 16) + y_offset

            draw_sprite_ext(sprite, 0, px, py, col_width / 32, y_scale, 0, color, alpha)
        }
    }
})
