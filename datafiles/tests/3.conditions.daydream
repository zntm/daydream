test_group("if", [
    test("if", fn() {
        var x = 0

        if (x == 0) {
            x = 1
        }

        test_expect(x, 1)
    }),
    test("if/else", fn() {
        var x = 1

        if (x == 0) {
            x = 1
        } else {
            x = 2
        }

        test_expect(x, 2)
    }),
    test("if/else if", fn() {
        var x = 2

        if (x == 0) {
            x = 1
        } else if (x == 1) {
            x = 2
        } else {
            x = 3
        }

        test_expect(x, 3)
    })
])

test_group("switch", [
    test("switch", fn() {
        var x = 0

        switch (x) {
            case 0: x = 1 break
            case 1: x = 2 break
        }

        test_expect(x, 1)
    }),
    test("switch with default", fn() {
        var x = 2

        switch (x) {
            case 0: x = 1 break
            case 1: x = 2 break
            default: x = 3 break
        }

        test_expect(x, 3)
    })
])
