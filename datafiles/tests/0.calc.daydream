test_group("math", [
    test("add", fn() {
        test_expect(1 + 2, 3)
        test_expect(5.1 + 10.6, 15.7)
    }),
    test("sub", fn() {
        test_expect(3 - 2, 1)
        test_expect(10.6 - 5.1, 5.5)
    }),
    test("mul", fn() {
        test_expect(2 * 3, 6)
        test_expect(5.1 * 10.6, 54.06)
    }),
    test("div", fn() {
        test_expect(6 / 2, 3)
        test_expect(10.6 / 5.1, 2.078431372549019)
    }),
    test("mod", fn() {
        test_expect(7 % 2, 1)
        test_expect(10.6 % 5.1, 0.4)
    }),
    test("pow", fn() {
        test_expect(2 ** 3, 8)
        test_expect(5.1 ** 2, 26.01)
    }),
    test("pemdas", fn() {
        test_expect(5 + 3 * 2, 11)
        test_expect(5 + 3 * 2.5, 12.5)
        test_expect(5 + 3 * 2 / 4, 6.5)
    }),
    test("parenthesis", fn() {
        test_expect((5 + 3) * 2, 16)
        test_expect(5 + (3 * 2), 11)
        test_expect(5 + 3 * (2 / 4), 6.5)
    }),
])

test_group("bitwise", [
    test("and", fn() {
        test_expect(5 & 3, 1)
        test_expect(7 & 11, 3)
    }),
    test("or", fn() {
        test_expect(5 | 3, 7)
        test_expect(7 | 9, 15)
    }),
    test("xor", fn() {
        test_expect(5 ^ 3, 6)
        test_expect(8 ^ 3, 11)
    }),
    test("not", fn() {
        test_expect(~0, -1)
        test_expect(~5, -6)
    }),
    test("lshift", fn() {
        test_expect(1 << 4, 16)
        test_expect(5 << 3, 40)
    }),
    test("rshift", fn() {
        test_expect(16 >> 2, 4)
        test_expect(15 >> 1, 7)
    })
])
