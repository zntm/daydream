var bar_empty = $sprite(spr_GUI_Stat_Bar_Empty) {
    slices = (1, 0, 4, 0)
}

@area(hp_container) {
    position = (1, -15)
    size = (160, 7)
    
    @image(hp_icon) {
        position = (0, -1)
        source = $sprite(spr_GUI_Stat_Icon_HP)
    }
    
    @bar(hp_fill) {
        position = (7, 0)
        size = (140, 5)
        value = *hp_value
        max = *hp_max
        sprite_empty = bar_empty
        sprite_fill = $sprite(spr_GUI_Stat_Bar_HP) {
            slices = (1, 0, 4, 0)
        }
    }
}

@area(stamina_container) {
    position = (1, -7)
    size = (160, 7)
    
    @image(stamina_icon) {
        position = (0, 0)
        source = $sprite(spr_GUI_Stat_Icon_Stamina)
    }
    
    @bar(stamina_fill) {
        position = (7, 1)
        size = (140, 5)
        value = *stamina_value
        max = *stamina_max
        sprite_empty = bar_empty
        sprite_fill = $sprite(spr_GUI_Stat_Bar_Stamina) {
            slices = (1, 0, 4, 0)
        }
    }
}
