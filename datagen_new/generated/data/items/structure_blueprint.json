{
    "inventory": "#phantasia:item/generic/inventory_default",
    "sprite": "phantasia:item/structure_blueprint",
    "tile": {
        "audio_properties": {
            "lowpass": 0.65,
            "reverb": 0.5
        },
        "components": {
            "id": {
                "default": "",
                "max": 80,
                "min": 0,
                "type": "string"
            },
            "turns_into": {
                "default": "",
                "max": 80,
                "min": 0,
                "type": "string"
            },
            "xoffset": {
                "default": 0,
                "max": 127,
                "min": -128,
                "type": "s8"
            },
            "xscale": {
                "default": 1,
                "max": 255,
                "min": 1,
                "type": "u8"
            },
            "yoffset": {
                "default": 0,
                "max": 127,
                "min": -128,
                "type": "s8"
            },
            "yscale": {
                "default": 1,
                "max": 255,
                "min": 1,
                "type": "u8"
            }
        },
        "on_use": [
            {
                "id": "@phantasia:open_ui",
                "parameters": {
                    "ui": "ui/structure_blueprint.ui",
                    "definition": "structure_blueprint_menu",
                    "bindings": {
                        "id": "component:id",
                        "turns_into": "component:turns_into",
                        "xoffset": "component:xoffset",
                        "yoffset": "component:yoffset",
                        "xscale": "component:xscale",
                        "yscale": "component:yscale"
                    }
                }
            }
        ],
        "sfx": "#phantasia:tile/sfx/stone"
    },
    "type": "solid"
}